{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CQA Hackathon Results 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "team_name",
    "model",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "team_name": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "name"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "external_api",
            "hybrid"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversation_id",
              "status",
              "criteria",
              "score"
            ],
            "properties": {
              "conversation_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "ok"
              },
              "criteria": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterion_id",
                    "value",
                    "rationale",
                    "evidence_turns"
                  ],
                  "properties": {
                    "criterion_id": {
                      "enum": [
                        "contact",
                        "discovery",
                        "identification",
                        "consultation",
                        "empathy",
                        "dialogue",
                        "closure",
                        "critical"
                      ]
                    },
                    "value": {
                      "type": [
                        "boolean",
                        "integer",
                        "null"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_turns": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "contact"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              true,
                              false
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "discovery"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              true,
                              false,
                              null
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "identification"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              true,
                              false,
                              null
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "consultation"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              0,
                              5,
                              10,
                              15,
                              20,
                              null
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "empathy"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              true,
                              false
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "dialogue"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              0,
                              4,
                              7,
                              10
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "closure"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              true,
                              false,
                              null
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "criterion_id": {
                            "const": "critical"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "enum": [
                              true,
                              false
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "score": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "final_score",
                  "critical_flag"
                ],
                "properties": {
                  "final_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "multipleOf": 0.01
                  },
                  "critical_flag": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversation_id",
              "status",
              "criteria",
              "score",
              "error"
            ],
            "properties": {
              "conversation_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "error"
              },
              "criteria": {
                "type": "array",
                "maxItems": 0
              },
              "score": {
                "type": "null"
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
